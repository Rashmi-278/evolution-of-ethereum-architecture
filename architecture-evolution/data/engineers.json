 "sequences": [
  {
   "from": 0,
   "title": "Making a block with proof of work (~13 s)",
   "steps": [
    [
     "Pick txs",
     "Miner sorts the txpool by gas price"
    ],
    [
     "Execute",
     "EVM runs them, new state root"
    ],
    [
     "Mine",
     "Search for a nonce (Ethash)"
    ],
    [
     "Gossip",
     "Block goes out over devp2p"
    ],
    [
     "Re-execute",
     "Every node re-runs the block"
    ],
    [
     "Heaviest chain",
     "Forks resolve by total difficulty"
    ]
   ]
  },
  {
   "from": 5,
   "title": "Proposing a block with proof of stake (one 12 s slot)",
   "steps": [
    [
     "Duty",
     "VC learns it owns this slot"
    ],
    [
     "Prepare",
     "CL → EL: forkchoiceUpdated + attributes"
    ],
    [
     "Get block",
     "EL getPayload, or a MEV-Boost bid"
    ],
    [
     "Sign",
     "VC checks slashing DB, signs (BLS)"
    ],
    [
     "Gossip",
     "CL broadcasts block (+ blobs/columns)"
    ],
    [
     "Verify",
     "Peers: newPayload → EL re-executes"
    ]
   ]
  },
  {
   "from": 10,
   "title": "Proposing a block with ePBS (Glamsterdam, testnet)",
   "steps": [
    [
     "Bids",
     "Staked builders gossip bids"
    ],
    [
     "Commit",
     "Proposer signs a beacon block with one bid"
    ],
    [
     "Reveal",
     "Builder publishes the payload + BAL"
    ],
    [
     "PTC vote",
     "Committee confirms a timely reveal"
    ],
    [
     "Parallel check",
     "Peers validate with the access list"
    ],
    [
     "Pay",
     "Builder payment settles on the beacon chain"
    ]
   ]
  },
  {
   "from": 11,
   "title": "Proposing a block with ePBS + FOCIL (Hegotá, planned)",
   "steps": [
    [
     "Lists",
     "IL committee gossips inclusion lists"
    ],
    [
     "Bids",
     "Builders bid; blocks must honour the lists"
    ],
    [
     "Commit",
     "Proposer signs one bid"
    ],
    [
     "Reveal",
     "Builder publishes payload + BAL"
    ],
    [
     "Check lists",
     "Attesters reject blocks that skip IL txs"
    ],
    [
     "Verify",
     "PTC vote, parallel validation"
    ]
   ]
  },
  {
   "from": 12,
   "title": "Proposing a block in the Lean era (research)",
   "steps": [
    [
     "Build",
     "Builder executes the block"
    ],
    [
     "Prove",
     "Prover makes a zk proof of the block"
    ],
    [
     "Commit",
     "Proposer signs the block + proof"
    ],
    [
     "Gossip",
     "Block, proof and columns go out"
    ],
    [
     "Verify proof",
     "Validators check the proof, no re-execution"
    ],
    [
     "Finalize",
     "Fast finality in seconds"
    ]
   ]
  }
